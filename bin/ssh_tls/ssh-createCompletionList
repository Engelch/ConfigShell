#!/usr/bin/env bash

#########################################################################################
# ConfigShell lib 1.1 (codebase 1.0.0)
bashLib="/opt/ConfigShell/lib/bashlib.sh"
[ ! -f "$bashLib" ] && 1>&2 echo "bash-library $bashLib not found" && exit 127
# shellcheck source=/opt/ConfigShell/lib/bashlib.sh
source "$bashLib"
unset bashLib
#########################################################################################

[ "$1" = '-h' ] && {
    echo "DESCRIPTION"
    echo "  Create a file for ssh-completions."
    echo 
    echo "SYNOPSIS"
    echo "  $(basename $0) [-v | -p]"
    echo "  $(basename $0) -h"
    echo "  $(basename $0) -V"
    echo
    echo "OPTIONS"
    echo "  -v: output to stdout instead of the file $HOME/.ssh/completion.lst"
    echo "  -p: output the files to be parsed by $(basename $0)"
    echo "  -h: show help"
    echo "  -V: show version"   
    exit 1
}

[ "$1" = '-V' ] && {
    echo "$(basename $0) version 2.2.0" 1>&2
    exit 1
}

# -v ::= output to stdout instead of the file
output="$HOME/.ssh/completion.lst"
[ "$1" = '-v' ] && output='/dev/tty'

if [ "$1" = '-p' ] ; then
    find -L  ~/.ssh/  \( -name \*.config -o -name \*.conf -o -name \*.cfg \) -type f | grep -v \.old | grep -E '\.ssh/Config\..*\.d/' 
    exit $?
fi

find -L  ~/.ssh/ \( -name \*.config -o -name \*.conf -o -name \*.cfg \) -type f | \
    grep -v \.old | \
    grep -E '\.ssh/Config\..*\.d/' | \
    xargs grep -Ei '^host ' | \
    sed -E 's/#.*$//' | \
    sed -E 's/^.*:[Hh]ost //' | \
    tr " " "\n" | \
    grep -vE '^[[:space:]]*$' | \
    grep -v '\*' | \
    sort | \
    uniq >| "$output"
